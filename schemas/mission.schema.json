{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/chrisvoncsefalvay/autostar/schemas/mission.schema.json",
  "title": "a* mission metadata",
  "description": "Run metadata written once at run start to mission.json.",
  "type": "object",
  "required": ["run_id", "budget"],
  "properties": {
    "run_id": {
      "type": "string",
      "description": "Unique run identifier"
    },
    "goal": {
      "type": "string",
      "description": "Plain language description of the optimisation goal"
    },
    "artifact": {
      "type": "string",
      "description": "What is being mutated and where it lives"
    },
    "plays_enabled": {
      "type": "boolean",
      "description": "Whether coordinated parameter plays are enabled"
    },
    "budget": {
      "type": "object",
      "properties": {
        "strategy": {
          "type": "string",
          "enum": ["front_loaded", "track_priority", "confidence_weighted", "user_directed"]
        },
        "total_steps": { "type": "integer", "minimum": 1 },
        "total_tokens": { "type": "integer", "minimum": 0 },
        "total_cost_usd": { "type": "number", "minimum": 0 },
        "total_wall_minutes": { "type": "number", "minimum": 0 },
        "total_rounds": { "type": "integer", "minimum": 1 },
        "meta_reserve_pct": { "type": "number", "default": 12.5 }
      }
    },
    "stopping_criteria": {
      "type": "object",
      "properties": {
        "score_threshold": { "type": "number", "minimum": 0, "maximum": 1 },
        "plateau_rounds": { "type": "integer", "minimum": 1 }
      }
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    }
  }
}
