{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/chrisvoncsefalvay/autostar/schemas/track-trajectories.schema.json",
  "title": "a* track trajectories snapshot",
  "description": "Derived trajectory snapshot generated from append-only step logs.",
  "type": "object",
  "required": ["schema_version", "run_id", "updated_at", "composite", "per_track"],
  "properties": {
    "schema_version": {
      "type": "string",
      "const": "1.0"
    },
    "run_id": {
      "type": "string"
    },
    "project_id": {
      "type": ["string", "null"]
    },
    "updated_at": {
      "type": "string",
      "format": "date-time"
    },
    "derived_from": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "composite": {
      "type": "array",
      "items": {
        "type": "number"
      }
    },
    "per_track": {
      "type": "object",
      "additionalProperties": {
        "type": "array",
        "items": {
          "type": "number"
        }
      }
    },
    "limiting_track": {
      "type": ["string", "null"]
    }
  }
}
